#!/usr/bin/env bash
# mise description="Create ledctl.app bundle from the universal binary"
set -euo pipefail

if [[ -n "${VERSION:-}" ]]; then
    VERSION="${VERSION#v}"
else
    VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')
fi

mkdir -p ledctl.app/Contents/MacOS
mkdir -p ledctl.app/Contents/Resources
cp target/ledctl ledctl.app/Contents/MacOS/ledctl
cp bundle/Credits.html ledctl.app/Contents/Resources/Credits.html

cat > ledctl.app/Contents/Info.plist << PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>ledctl</string>
    <key>CFBundleIdentifier</key>
    <string>no.roht.ledctl</string>
    <key>CFBundleName</key>
    <string>ledctl</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${VERSION}</string>
    <key>CFBundleVersion</key>
    <string>${VERSION}</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© Thor Høgås</string>
    <key>NSInputMonitoringUsageDescription</key>
    <string>ledctl needs input monitoring access to read and control keyboard indicator LEDs (Caps Lock, Num Lock, Scroll Lock).</string>
</dict>
</plist>
PLIST

echo "Created ledctl.app (version ${VERSION})"
